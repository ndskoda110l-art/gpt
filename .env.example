# App
NODE_ENV=production
APP_PORT=3000
APP_URL=https://sms.tvojadomena.sk
JWT_SECRET=change_me

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sms_gateway
DB_USER=sms_user
DB_PASSWORD=change_me

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_SUCCESS_URL=https://sms.tvojadomena.sk/billing/success
STRIPE_CANCEL_URL=https://sms.tvojadomena.sk/billing/cancel
STRIPE_API_VERSION=2024-06-20
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# EuroSMS (názvy prispôsob podľa ich dokumentácie)
EUROSMS_API_URL=https://api.eurosms.example/send
EUROSMS_API_KEY=change_me
EUROSMS_SENDER=MyBrand
EUROSMS_API_VERSION=3.x
EUROSMS_API_PROTOCOL=rest
EUROSMS_DLR_SECRET=change_me

# Queue / Redis (voliteľné ale odporúčané)
REDIS_URL=redis://127.0.0.1:6379

# SMS billing / worker
SMS_PRICE_CENTS=5
WORKER_INTERVAL_MS=15000
WORKER_MAX_ATTEMPTS=3
